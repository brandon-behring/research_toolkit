{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-toolkit.local/schemas/v1/source-record.schema.json",
  "title": "SourceRecord v1",
  "type": "object",
  "required": ["schema_version", "source_id", "requested_url", "canonical_url", "source_kind", "title", "authority_scope", "independence_cluster", "rights_status", "visibility", "retrieved_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "source_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "requested_url": {"type": "string", "format": "uri"},
    "canonical_url": {"type": "string", "format": "uri"},
    "final_url": {"type": "string", "format": "uri"},
    "source_kind": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "authority_scope": {"type": "string", "minLength": 1},
    "independence_cluster": {"type": "string", "minLength": 1},
    "rights_status": {"type": "string", "enum": ["public", "private-use", "restricted", "unknown"]},
    "visibility": {"type": "string", "enum": ["public", "private", "restricted", "unknown"]},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "normalized_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "license": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
