{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-toolkit.local/schemas/v1/claim-record.schema.json",
  "title": "ClaimRecord v1",
  "type": "object",
  "required": ["schema_version", "claim_id", "text", "claim_type", "status", "evidence_ids", "confidence", "created_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "claim_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "text": {"type": "string", "minLength": 1},
    "claim_type": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["active", "unresolved", "superseded", "removed"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"}, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "superseded_by": {"type": ["string", "null"]},
    "scope": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
