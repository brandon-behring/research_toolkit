{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-toolkit.local/schemas/v1/claim-review-record.schema.json",
  "title": "ClaimReviewRecord v1",
  "type": "object",
  "required": ["schema_version", "review_id", "claim_id", "reviewer", "reviewed_at", "disposition", "entailment", "currency", "methodology", "risk_of_bias", "confidence", "evidence_ids", "independent"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "review_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "claim_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "disposition": {"type": "string", "enum": ["supported", "narrow", "rewrite", "remove", "unresolved"]},
    "entailment": {"type": "string", "enum": ["full", "partial", "none", "uncertain"]},
    "currency": {"type": "string", "enum": ["current", "stale", "superseded", "uncertain"]},
    "methodology": {"type": "string", "minLength": 1},
    "risk_of_bias": {"type": "string", "enum": ["low", "moderate", "high", "uncertain", "not-applicable"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "independent": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
