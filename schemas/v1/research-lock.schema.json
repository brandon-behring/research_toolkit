{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-toolkit.local/schemas/v1/research-lock.schema.json",
  "title": "ResearchLock v1",
  "type": "object",
  "required": ["schema_version", "lock_version", "release_id", "dossier_release_sha256", "toolkit", "artifacts", "generated_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "lock_version": {"type": "string", "const": "1"},
    "release_id": {"type": "string", "pattern": "^rr-[0-9]{8}[.][0-9]+$"},
    "dossier_release_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "toolkit": {"type": "object", "required": ["commit", "version"], "properties": {"commit": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
