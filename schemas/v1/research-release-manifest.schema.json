{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-toolkit.local/schemas/v1/research-release-manifest.schema.json",
  "title": "ResearchReleaseManifest v1",
  "type": "object",
  "required": ["schema_version", "release_id", "created_at", "freshness_cutoff", "repositories", "artifacts", "validators", "unresolved_findings", "waivers", "reviewer_acceptance"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "release_id": {"type": "string", "pattern": "^rr-[0-9]{8}[.][0-9]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "freshness_cutoff": {"type": "string", "format": "date"},
    "repositories": {"type": "array", "items": {"type": "object", "required": ["name", "commit"], "properties": {"name": {"type": "string"}, "commit": {"type": "string"}}, "additionalProperties": false}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "validators": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "version", "status"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "status": {"type": "string", "enum": ["pass", "fail", "waived"]}}, "additionalProperties": false}},
    "unresolved_findings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "waivers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reviewer_acceptance": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["reviewer", "accepted_at"], "properties": {"reviewer": {"type": "string"}, "accepted_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
